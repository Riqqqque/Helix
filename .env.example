COMPOSE_PROJECT_NAME=server-dashboard
HELIX_IMAGE_TAG=local
HELIX_SOURCE_REVISION=unknown
HELIX_LAN_BIND_ADDRESS=192.168.1.10
HELIX_LAN_PORT=3100
HELIX_BROKER_GID=991
HELIX_TERMINAL_GID=992
HELIX_GATEWAY_HOST=192.168.1.10
HELIX_BROWSER_ORIGIN=http://192.168.1.10:3100
HELIX_ALLOWED_CLIENT_CIDR=192.168.1.0/24
# Keep these inert values when no private secondary entry point is used. They
# can later be replaced by a Tailscale Serve hostname/origin and tailnet CIDR
# without weakening the LAN Host and Origin boundary.
HELIX_SECONDARY_GATEWAY_HOST=unused.invalid
HELIX_SECONDARY_BROWSER_ORIGIN=http://unused.invalid
HELIX_SECONDARY_ALLOWED_CLIENT_CIDR=192.0.2.254/32
HELIX_DATA_DIR=./data
HELIX_BACKUP_DIR=./backups
