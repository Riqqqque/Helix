map "$request_method|$http_origin" $helix_origin_allowed {
    default 0;
    ~^(GET|HEAD)\| 1;
    "POST|${HELIX_BROWSER_ORIGIN}" 1;
    "PUT|${HELIX_BROWSER_ORIGIN}" 1;
    "DELETE|${HELIX_BROWSER_ORIGIN}" 1;
    "POST|${HELIX_SECONDARY_BROWSER_ORIGIN}" 1;
    "PUT|${HELIX_SECONDARY_BROWSER_ORIGIN}" 1;
    "DELETE|${HELIX_SECONDARY_BROWSER_ORIGIN}" 1;
}

map "$host" $helix_host_allowed {
    default 0;
    "${HELIX_GATEWAY_HOST}" 1;
    "${HELIX_SECONDARY_GATEWAY_HOST}" 1;
}

map "$http_origin" $helix_terminal_origin_allowed {
    default 0;
    "${HELIX_BROWSER_ORIGIN}" 1;
    "${HELIX_SECONDARY_BROWSER_ORIGIN}" 1;
}

server {
    listen 3000;
    server_name ${HELIX_GATEWAY_HOST} ${HELIX_SECONDARY_GATEWAY_HOST};
    server_tokens off;

    # The Rust routes apply tighter per-endpoint limits. This ceiling permits
    # bounded text-file edits and dashboard layouts without letting Nginx spool
    # an arbitrarily large request.
    client_max_body_size 6m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 30s;
    send_timeout 15s;

    if ($helix_host_allowed = 0) {
        return 421;
    }

    if ($helix_origin_allowed = 0) {
        return 403;
    }

    location = /gateway-healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location = /api/v1/terminal/connect {
        if ($helix_terminal_origin_allowed = 0) {
            return 403;
        }

        allow 127.0.0.1;
        allow ${HELIX_ALLOWED_CLIENT_CIDR};
        allow ${HELIX_SECONDARY_ALLOWED_CLIENT_CIDR};
        deny all;

        limit_except GET {
            deny all;
        }

        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 3s;
        proxy_read_timeout 8h;
        proxy_send_timeout 30s;
        proxy_buffering off;

        proxy_set_header Host "127.0.0.1:8080";
        proxy_set_header Origin "http://127.0.0.1:8080";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";

        proxy_cookie_flags helix_session httponly samesite=strict;
        proxy_cookie_flags helix_terminal_ticket httponly samesite=strict;

        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }

    location / {
        allow 127.0.0.1;
        allow ${HELIX_ALLOWED_CLIENT_CIDR};
        allow ${HELIX_SECONDARY_ALLOWED_CLIENT_CIDR};
        deny all;

        limit_except GET HEAD POST PUT DELETE {
            deny all;
        }

        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering on;
        proxy_max_temp_file_size 0;

        proxy_set_header Host "127.0.0.1:8080";
        proxy_set_header Origin "http://127.0.0.1:8080";
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";

        proxy_cookie_flags helix_session httponly samesite=strict;

        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;

        add_header Referrer-Policy "no-referrer" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    }
}
